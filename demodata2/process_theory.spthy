// 4 Loop restriction
restriction Max_1_Inspect:
  "not (Ex fr #t1 #t2.
       Inspect(fr)@#t1 &
       Inspect(fr)@#t2 &
       #t1 < #t2)"

// 5. Complete traces
restriction Force_Trace_Completion:
  "not (Ex fr #tinit. Tamstart(fr)@#tinit &
       not (Ex #tend. Tamend(fr)@tend))"

// original: ((!(con_approve))U(con_inspect)) || G(!(con_approve))
// simpnorm: !con_approve W con_inspect
lemma lemma_1:
  "All fr #t. Tamstart(fr) @t ==> (
      ((Ex #ttj #ttlast . Tamalways(fr)@ttj & Tamend(fr)@ttlast & ( #t < #ttj & #ttj < #ttlast | #t = #ttj | #ttj = #ttlast) & Inspect(fr)@ttj &  (All #ttk . Tamalways(fr)@ttk & (#t < #ttk & #ttk < #ttj | #t = #ttk)  ==> not(Approve(fr)@ttk)) ) | (All #tt. Tamalways(fr)@tt & (#t < #tt | #t = #tt) ==> not(Approve(fr)@tt)))
  )"


// original: G((con_rework) -> F(con_inspect))
// simpnorm: G(!con_rework | Fcon_inspect)
lemma lemma_2:
  "All fr #t. Tamstart(fr) @t ==> (
      (All #tt. Tamalways(fr)@tt & (#t < #tt | #t = #tt) ==> (Rework(fr)@tt ==> (Ex #ttc. Tamalways(fr)@ttc & (#tt < #ttc | #tt = #ttc) & Inspect(fr)@ttc)))
  )"


